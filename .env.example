# Praman environment template — copy to .env and fill in real values.
# .env is gitignored; never commit real keys to .env.example or anywhere else.

# Gemini API (Google AI Studio)
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Dedicated vision / OCR key (a separate Gemini key isolated from the general one
# so vision rate-limit pressure does not starve the extraction layer). If you
# only have one key, leave this blank — the code will fall back to GEMINI_API_KEY.
GEMINI_VISION_API_KEY=

# Default Gemini models (override only if you know what you are doing)
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash

# OPA server (run locally on Day 4)
OPA_URL=http://127.0.0.1:8181

# OCR confidence threshold below which a fact is routed to ABSTAIN
OCR_CONFIDENCE_THRESHOLD=0.85

# Django
DJANGO_SECRET_KEY=replace_me_with_a_long_random_string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
